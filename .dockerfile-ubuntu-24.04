FROM ubuntu:24.04

RUN apt-get update
RUN DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC\
    apt-get install -y apt-utils \
                       rcs \
                       subversion \
                       git \
                       libjs-mathjax \
                       python3 \
                       python3-pip \
                       tzdata

ARG DOKUFORGE_COMMIT_ID
ENV DOKUFORGE_COMMIT_ID=$DOKUFORGE_COMMIT_ID

COPY .git /DokuForge2/.git
WORKDIR /DokuForge2/
RUN git checkout $DOKUFORGE_COMMIT_ID .

RUN pip install --no-cache-dir --break-system-packages -r requirements.txt

# for newer markupsafe, we get an error
RUN pip install --no-cache-dir --break-system-packages markupsafe==2.0.1

EXPOSE 8800
